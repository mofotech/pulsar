# Docker Compose — Pulsar data-plane agents for node {{ node_id | default(inventory_hostname) }}
# Generated by Ansible. Do not edit manually.

name: pulsar-agent

services:

  agent-compute:
    image: {{ pulsar_image }}
    restart: unless-stopped
    command: ["agent", "--pillar=compute", "--config", "/etc/pulsar/pulsar-agent.yaml"]
    user: root
    privileged: true
    volumes:
      - {{ pulsar_config_dir }}/pulsar-agent.yaml:/etc/pulsar/pulsar-agent.yaml:ro
      - /var/run/libvirt/libvirt-sock:/var/run/libvirt/libvirt-sock
      - {{ compute_image_cache_dir }}:{{ compute_image_cache_dir }}
      - {{ compute_instance_dir }}:{{ compute_instance_dir }}
      - /dev:/dev
      - /sys:/sys
      - /run/udev:/run/udev
      - /lib/modules:/lib/modules:ro
      - /proc/1/ns:/host-proc-ns:ro
      - /etc/iscsi:/etc/iscsi
    devices:
      - /dev/kvm:/dev/kvm
    extra_hosts:
      - "host.docker.internal:host-gateway"

  agent-network:
    image: {{ pulsar_image }}
    restart: unless-stopped
    command: ["agent", "--pillar=network", "--config", "/etc/pulsar/pulsar-agent.yaml"]
    user: root
    network_mode: host
    environment:
      - PULSAR_AGENT_CONTROLLER_GRPC={{ pulsar_controller_grpc }}
    volumes:
      - {{ pulsar_config_dir }}/pulsar-agent.yaml:/etc/pulsar/pulsar-agent.yaml:ro
      - /var/run/ovn:/var/run/ovn
      - /var/run/openvswitch:/var/run/openvswitch
    cap_add:
      - NET_ADMIN
      - NET_RAW
      - SYS_MODULE

  agent-storage:
    image: {{ pulsar_image }}
    restart: unless-stopped
    command: ["agent", "--pillar=storage", "--config", "/etc/pulsar/pulsar-agent.yaml"]
    user: root
    network_mode: host
    privileged: true
    environment:
      - PULSAR_AGENT_CONTROLLER_GRPC={{ pulsar_controller_grpc }}
    volumes:
      - {{ pulsar_config_dir }}/pulsar-agent.yaml:/etc/pulsar/pulsar-agent.yaml:ro
      - /dev:/dev
      - /run/lock/lvm:/run/lock/lvm
      - /etc/lvm:/etc/lvm
      - /run/tgtd:/run/tgtd
