# Pulsar agent configuration — generated by Ansible for node {{ node_id | default(inventory_hostname) }}
# Do not edit manually; changes will be overwritten on the next ansible-playbook run.

agent:
  controller_grpc: "{{ pulsar_controller_grpc }}"
  node_id: "{{ node_id | default(inventory_hostname) }}"

  compute:
    hypervisor_drivers:
{% for drv in compute_hypervisor_drivers %}
      - {{ drv }}
{% endfor %}
    image_cache_dir: "{{ compute_image_cache_dir }}"
    instance_dir:    "{{ compute_instance_dir }}"
    domain_type: "{{ compute_domain_type }}"
    emulator:    "{{ compute_emulator }}"

  network:
    external_interface: "{{ ovn_external_interface }}"
    overlay_interface:  "{{ network_overlay_interface }}"
    vxlan_port: 4789
    ovn_nb_addr: "{{ network_ovn_nb_addr }}"  # tcp:<controller_ip>:6641 for remote nodes
    ovs_bridge:  "{{ ovs_bridge }}"
    physnet_name: "{{ ovn_physnet_name }}"
    ovn_chassis_name: "{{ node_id | default(inventory_hostname) }}"

  storage:
    node_ip: "{{ storage_node_ip | default('') }}"
    backends:
      lvm:
        volume_group: "{{ lvm_volume_group }}"
        thin_pool:    "{{ lvm_thin_pool }}"

logging:
  level: "{{ logging_level }}"
  format: "{{ logging_format }}"

telemetry:
  prometheus_listen: "{{ telemetry_prometheus_listen }}"
