# Copy to deploy/docker/.env and fill in. docker compose reads it automatically.
# .env is gitignored — never commit real values.

# JWT signing secret for the controller. Must be >= 32 bytes and not a
# placeholder, or the controller refuses to start. Generate with:
#   openssl rand -hex 32
PULSAR_JWT_SECRET=

# Postgres password for the "pulsar" user. Use hex/alphanumerics only (it is
# embedded in a DSN). Generate with: openssl rand -hex 24
#
# NOTE: Postgres only applies this when the pg-data volume is first created.
# For an EXISTING deployment either set this to the current password
# (previously "pulsar"), or change it in the database first:
#   docker compose exec postgres psql -U pulsar -c "ALTER USER pulsar PASSWORD '<new>';"
POSTGRES_PASSWORD=

# Browser-facing base URL of the web UI, used for OIDC redirect_uris.
# Must match the redirect URI registered with your IDP.
PULSAR_OIDC_BASE_URL=http://localhost:3000

# Internal networks the controller may contact for SSO (IdP discovery and token
# exchange), comma-separated CIDRs or IPs. By default only public IPs over
# https are allowed. Required for an on-prem / LAN Keycloak, e.g.:
#   PULSAR_OIDC_ALLOWED_NETWORKS=10.11.0.0/16
PULSAR_OIDC_ALLOWED_NETWORKS=

# ── Mutual TLS between the controller and agents (recommended) ──────────────
# Without it the agent gateway (:9090) is plaintext and anyone who can reach it
# can pose as an agent. Create certificates once (from deploy/docker/):
#   docker run --rm -v "$PWD/pki:/pki" pulsar:dev certs ca --dir /pki
#   docker run --rm -v "$PWD/pki:/pki" pulsar:dev certs controller --dir /pki \
#       --dns controller --ip 127.0.0.1 --ip <host IP agents use>
#   docker run --rm -v "$PWD/pki:/pki" pulsar:dev certs agent --dir /pki --name ag-pulsar-1
# (--name must equal the agent node_id in pulsar.docker.yaml.) Then move
# pki/ca.key somewhere offline and set the in-container paths below:
#   PULSAR_GRPC_TLS_CA_CERT=/etc/pulsar/pki/ca.crt
#   PULSAR_GRPC_TLS_CERT=/etc/pulsar/pki/controller.crt
#   PULSAR_GRPC_TLS_KEY=/etc/pulsar/pki/controller.key
#   PULSAR_AGENT_TLS_CERT=/etc/pulsar/pki/ag-pulsar-1.crt
#   PULSAR_AGENT_TLS_KEY=/etc/pulsar/pki/ag-pulsar-1.key
PULSAR_GRPC_TLS_CA_CERT=
PULSAR_GRPC_TLS_CERT=
PULSAR_GRPC_TLS_KEY=
PULSAR_AGENT_TLS_CERT=
PULSAR_AGENT_TLS_KEY=
